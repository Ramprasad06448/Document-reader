# DocuEase Backend Environment Configuration Template
# Copy this file to .env and replace placeholder values with your actual configuration.

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Tesseract OCR Executable Path (Windows default or custom path)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Google Gemini API Key (Required for Phase 2 AI Simplification)
GEMINI_API_KEY=your_gemini_api_key_here

# Client CORS Origin
CORS_ORIGIN=http://localhost:5173
